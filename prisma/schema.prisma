generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String                         @id
  name                      String
  email                     String                         @unique
  emailVerified             Boolean
  image                     String?
  roles                     String[]                       @default([])
  emailNotificationsEnabled Boolean                        @default(true)
  createdAt                 DateTime
  updatedAt                 DateTime
  sessions                  Session[]
  accounts                  Account[]
  submittedPwas             PwaApp[]                       @relation("PwaSubmittedBy")
  reviewedPwas              PwaApp[]                       @relation("PwaReviewedBy")
  developerProfileMembers   DeveloperProfileMember[]
  sentDeveloperInvitations  DeveloperProfileInvitation[]
  submittedFlatpaks         FlatpakApp[]                   @relation("FlatpakSubmittedBy")
  reviewedFlatpaks          FlatpakApp[]                   @relation("FlatpakReviewedBy")
  triggeredFlatpakBuilds    FlatpakBuild[]                 @relation("FlatpakBuildTriggeredBy")
  verifiedDeveloperProfiles DeveloperProfile[]             @relation("DeveloperProfileVerifiedBy")
  requestedVerifications    DeveloperVerificationRequest[] @relation("VerificationRequestedBy")
  reviewedVerifications     DeveloperVerificationRequest[] @relation("VerificationRequestReviewedBy")
  notifications             Notification[]
  submittedScreenshots      ScreenshotSubmission[]         @relation("ScreenshotSubmittedBy")
  reviewedScreenshots       ScreenshotSubmission[]         @relation("ScreenshotReviewedBy")
  appLists                  AppList[]
}

model Session {
  id                       String   @id
  expiresAt                DateTime
  token                    String   @unique
  createdAt                DateTime
  updatedAt                DateTime
  ipAddress                String?
  userAgent                String?
  activeDeveloperProfileId String?
  userId                   String
  user                     User     @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model FrontPage {
  id        String   @id @default("singleton")
  sections  Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model PwaTranslation {
  id          String   @id @default(cuid())
  appId       String
  app         PwaApp   @relation(references: [id], fields: [appId], onDelete: Cascade)
  lang        String
  name        String?
  summary     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([appId, lang])
}

enum PwaStatus {
  PENDING
  APPROVED
  REJECTED
  PULLED // was approved/live, a reviewer withdrew it; re-approvable
}

// Better-auth's "organization" plugin, renamed throughout to "developer profile"
// since that's what an org represents in Forge: the publisher identity behind PWA submissions.
model DeveloperProfile {
  id                   String                         @id
  name                 String                         @unique
  slug                 String                         @unique
  logo                 String?
  metadata             String?
  createdAt            DateTime
  // Set/revoked by a reviewer (or higher) via /dashboard/verified-developers.
  // Checked by the public /api/verified/[appid] endpoint - a staff-submitted
  // Flatpak (no developerProfileId at all) is always treated as verified there
  // regardless of this flag, see that route.
  verified             Boolean                        @default(false)
  verifiedById         String?
  verifiedBy           User?                          @relation("DeveloperProfileVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt           DateTime?
  members              DeveloperProfileMember[]
  invitations          DeveloperProfileInvitation[]
  pwaApps              PwaApp[]
  flatpakApps          FlatpakApp[]
  verificationRequests DeveloperVerificationRequest[]
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// A developer's request to have their profile marked DeveloperProfile.verified.
// Lands in the review queue like a PWA/Flatpak submission - approving it also
// flips DeveloperProfile.verified (the same flag a reviewer can otherwise set
// directly from /dashboard/verified-developers with no request at all).
model DeveloperVerificationRequest {
  id                 String                    @id @default(cuid())
  developerProfileId String
  developerProfile   DeveloperProfile          @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  // Proof of legitimacy submitted by the developer, shown to the reviewer.
  dunsNumber         String
  documentUrls       String[]
  status             VerificationRequestStatus @default(PENDING)
  requestedById      String?
  requestedBy        User?                     @relation("VerificationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?                     @relation("VerificationRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([developerProfileId, status])
  @@index([status])
}

enum ScreenshotStatus {
  PENDING
  APPROVED
  REJECTED
}

// A developer-hosted image submitted so Forge can host it at a stable URL, for
// use as a PWA/Flatpak screenshot without needing external image hosting. Goes
// through the same review queue as PWA/Flatpak submissions rather than being
// usable immediately, so Forge's storage isn't an open, unmoderated image host.
model ScreenshotSubmission {
  id            String           @id @default(cuid())
  url           String
  mimeType      String
  fileName      String
  fileSize      Int
  status        ScreenshotStatus @default(PENDING)
  submittedById String?
  submittedBy   User?            @relation("ScreenshotSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById  String?
  reviewedBy    User?            @relation("ScreenshotReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([submittedById])
}

model DeveloperProfileMember {
  id                 String           @id
  developerProfileId String
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String           @default("member")
  createdAt          DateTime

  @@index([developerProfileId])
  @@index([userId])
}

model DeveloperProfileInvitation {
  id                 String           @id
  developerProfileId String
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  email              String
  role               String?
  status             String           @default("pending")
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  inviterId          String
  inviter            User             @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([developerProfileId])
  @@index([email])
}

model PwaApp {
  id                 String            @id @default(cuid())
  appid              String            @unique
  name               String
  summary            String
  description        String            @db.Text
  iconUrl            String
  screenshots        String[]
  homepageUrl        String            @default("")
  contentRating      String            @default("All ages")
  developerName      String
  url                String
  color              String            @default("#000000")
  css                String            @default("") @db.Text
  js                 String            @default("") @db.Text
  useragent          String            @default("")
  urlFilter          String            @default("")
  widevine           Boolean           @default(false)
  tray               Boolean           @default(false)
  status             PwaStatus         @default(PENDING)
  submittedById      String?
  submittedBy        User?             @relation("PwaSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?             @relation("PwaReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?           @db.Text
  developerProfileId String?
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  translations       PwaTranslation[]

  @@index([status])
}

enum FlatpakStatus {
  PENDING // awaiting review
  PROCESSING // approved, SSH build/publish running
  APPROVED // build succeeded, live
  REJECTED // reviewer rejected, no build attempted
  FAILED // build/publish failed, retryable
  PULLED // was approved/live, a reviewer withdrew it from the repo; re-approvable
}

enum FlatpakSourceType {
  BUNDLE // a prebuilt .flatpak file was uploaded
  GIT // built from a flatpak-builder manifest in a watched git repo
}

enum FlatpakBuildResult {
  PROCESSING
  SUCCESS
  FAILED
}

model FlatpakApp {
  id                 String            @id @default(cuid())
  appid              String            @unique
  branch             String            @default("stable")
  name               String
  summary            String
  description        String            @db.Text
  iconUrl            String
  screenshots        String[]
  homepageUrl        String            @default("")
  contentRating      String            @default("All ages")
  developerName      String
  developerProfileId String?
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: SetNull)
  sourceType         FlatpakSourceType @default(BUNDLE)
  bundleUrl          String?
  bundleFileName     String?
  bundleSize         Int?
  // Git source fields - only set when sourceType is GIT. gitLastCommit is the
  // commit the current build/review was triggered from; the watcher (see
  // git-watch.ts) compares this against the remote's HEAD to detect new pushes.
  gitUrl             String?
  gitBranch          String?
  gitManifestPath    String?
  gitLastCommit      String?
  status             FlatpakStatus     @default(PENDING)
  submittedById      String?
  submittedBy        User?             @relation("FlatpakSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?             @relation("FlatpakReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?           @db.Text
  // Log of the last one-off admin action (unpublish/pull), not a build - per-build
  // logs live in FlatpakBuild below, kept as history rather than overwritten.
  buildLog           String?           @db.Text
  buildStartedAt     DateTime?
  buildFinishedAt    DateTime?
  builds             FlatpakBuild[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([sourceType, status])
}

// One row per build attempt (approve/retry), capped at the 10 most recent per
// app (see triggerPublish in flatpak-publish.ts) - gives reviewers and
// submitters real history instead of a single buildLog field overwritten on
// every retry, and survives a Forge restart via the persisted screen/remote
// path fields (see flatpak-publish.ts's poller/reconciliation for why).
model FlatpakBuild {
  id                String             @id @default(cuid())
  flatpakAppId      String
  flatpakApp        FlatpakApp         @relation(fields: [flatpakAppId], references: [id], onDelete: Cascade)
  status            FlatpakBuildResult @default(PROCESSING)
  log               String             @db.Text
  gitCommit         String?
  // Remote screen session name plus the log/exit-marker file paths it writes to -
  // the poller in flatpak-publish.ts uses these to find and tail an in-progress
  // build over a fresh SSH connection each tick, independent of the connection
  // that launched it.
  screenSessionName String
  remoteLogPath     String
  remoteExitPath    String
  triggeredById     String?
  triggeredBy       User?              @relation("FlatpakBuildTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?

  @@index([flatpakAppId, startedAt])
}

// Singleton row (see FrontPage for the same pattern) holding infra secrets for the
// Flatpak publish pipeline. Only readable/writable by the "admin" group.
model InfraSettings {
  id                     String   @id @default("singleton")
  sshPublicKey           String?
  sshPrivateKeyEncrypted String?  @db.Text
  gpgPassphraseEncrypted String?  @db.Text
  remoteHost             String   @default("repo.blossomos.org")
  remoteUser             String   @default("forge")
  remoteRepoPath         String   @default("/srv/repos/flatpak")
  // Optional parent dir for the remote build scratch space (WORKDIR in
  // flatpak-publish.ts). Unset means fall back to the remote host's default
  // TMPDIR, which can be too small for a flatpak-builder build. See
  // buildRemoteScript for how this is used.
  buildWorkDir           String?
  updatedAt              DateTime @updatedAt
}

// Step-up email verification gating InfraSettings. Keyed by better-auth session id
// (not userId) so verifying in one browser doesn't silently elevate every other
// session the admin is logged in on. codeHash/codeExpiresAt track the one-time code
// itself; verifiedAt is only set once the code checks out, and access stays granted
// for a short window after that (see INFRA_ACCESS_TTL_MS in infra-access.ts) before
// a fresh code is required again.
model InfraAccessVerification {
  sessionId     String    @id
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int       @default(0)
  verifiedAt    DateTime?
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?  @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model WhitelistEntry {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
}

model Verification {
  id         String    @id
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model AppInstall {
  id        String   @id @default(cuid())
  appid     String
  createdAt DateTime @default(now())

  @@index([appid])
  @@index([appid, createdAt])
}

model FlathubCache {
  appid    String   @id
  installs Int
  cachedAt DateTime @default(now())
}

// A user-curated collection of apps, e.g. "my favorite dev tools". Deliberately
// unmoderated: id is a real UUID (not the app's usual cuid) because it doubles as
// the only access control for reading the list - anyone who has the id can fetch
// it via GET /api/lists/:id, no login required. Only the creator can edit it
// though, that's checked against createdById in the dashboard actions.
model AppList {
  id          String        @id @default(uuid())
  name        String
  // Optional human-friendly alternative to the id, chosen by the creator.
  // Setting one trades away some of the id's unguessability for a memorable
  // reference, e.g. for use in the frontpage designer's custom block.
  slug        String?       @unique
  // A plain URL, or an encoded value from src/lib/icon-value.ts: emoji:<char>
  // or lucide:<PascalName>:<hexColor>. Consumers other than the Forge
  // dashboard must parse this format themselves.
  icon        String?
  description String?       @db.Text
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       AppListItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([createdById])
}

// name/iconUrl are a snapshot taken when the app was added, not re-fetched live,
// so viewing a list doesn't depend on Flathub/arpi.blossomos.org/Forge's own PWA
// table all being up just to render it. appRef is either a bare Flatpak app id
// (e.g. "org.gnome.Gedit") or a Forge PWA id prefixed "pwa:" (e.g.
// "pwa:com.example.MyApp") - the same pwa: convention arc-daemon's own PWA
// provider already uses to tell the two apart.
model AppListItem {
  id        String   @id @default(cuid())
  listId    String
  list      AppList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  appRef    String
  name      String
  iconUrl   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([listId, appRef])
  @@index([listId])
}
