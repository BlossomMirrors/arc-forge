generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                         @id
  name                       String
  email                      String                         @unique
  emailVerified              Boolean
  image                      String?
  roles                      String[]                       @default([])
  emailNotificationsEnabled  Boolean                        @default(true)
  createdAt                  DateTime
  updatedAt                  DateTime
  sessions                   Session[]
  accounts                   Account[]
  submittedPwas              PwaApp[]                       @relation("PwaSubmittedBy")
  reviewedPwas               PwaApp[]                       @relation("PwaReviewedBy")
  developerProfileMembers    DeveloperProfileMember[]
  sentDeveloperInvitations   DeveloperProfileInvitation[]
  submittedFlatpaks          FlatpakApp[]                   @relation("FlatpakSubmittedBy")
  reviewedFlatpaks           FlatpakApp[]                   @relation("FlatpakReviewedBy")
  triggeredFlatpakBuilds     FlatpakBuild[]                 @relation("FlatpakBuildTriggeredBy")
  verifiedDeveloperProfiles  DeveloperProfile[]             @relation("DeveloperProfileVerifiedBy")
  suspendedDeveloperProfiles DeveloperProfile[]             @relation("DeveloperProfileSuspendedBy")
  requestedVerifications     DeveloperVerificationRequest[] @relation("VerificationRequestedBy")
  reviewedVerifications      DeveloperVerificationRequest[] @relation("VerificationRequestReviewedBy")
  notifications              Notification[]
  submittedScreenshots       ScreenshotSubmission[]         @relation("ScreenshotSubmittedBy")
  reviewedScreenshots        ScreenshotSubmission[]         @relation("ScreenshotReviewedBy")
  appLists                   AppList[]
  reviewedReports            Report[]
  createdRunners             Runner[]
}

model Session {
  id                       String   @id
  expiresAt                DateTime
  token                    String   @unique
  createdAt                DateTime
  updatedAt                DateTime
  ipAddress                String?
  userAgent                String?
  activeDeveloperProfileId String?
  userId                   String
  user                     User     @relation(references: [id], fields: [userId], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(references: [id], fields: [userId], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model FrontPage {
  id        String   @id @default("singleton")
  sections  Json     @default("[]")
  updatedAt DateTime @updatedAt
}

model PwaTranslation {
  id          String   @id @default(cuid())
  appId       String
  app         PwaApp   @relation(references: [id], fields: [appId], onDelete: Cascade)
  lang        String
  name        String?
  summary     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([appId, lang])
}

enum PwaStatus {
  PENDING
  APPROVED
  REJECTED
  PULLED
}

model DeveloperProfile {
  id                    String                         @id
  name                  String                         @unique
  slug                  String                         @unique
  logo                  String?
  metadata              String?
  createdAt             DateTime
  verified              Boolean                        @default(false)
  verifiedById          String?
  verifiedBy            User?                          @relation("DeveloperProfileVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt            DateTime?
  suspended             Boolean                        @default(false)
  suspendedById         String?
  suspendedBy           User?                          @relation("DeveloperProfileSuspendedBy", fields: [suspendedById], references: [id], onDelete: SetNull)
  suspendedAt           DateTime?
  suspendReason         String?                        @db.Text
  members               DeveloperProfileMember[]
  invitations           DeveloperProfileInvitation[]
  pwaApps               PwaApp[]
  flatpakApps           FlatpakApp[]
  verificationRequests  DeveloperVerificationRequest[]
  screenshotSubmissions ScreenshotSubmission[]
  appLists              AppList[]
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model DeveloperVerificationRequest {
  id                 String                    @id @default(cuid())
  developerProfileId String
  developerProfile   DeveloperProfile          @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  dunsNumber         String
  documentUrls       String[]
  status             VerificationRequestStatus @default(PENDING)
  requestedById      String?
  requestedBy        User?                     @relation("VerificationRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?                     @relation("VerificationRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?                   @db.Text
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([developerProfileId, status])
  @@index([status])
}

enum ScreenshotStatus {
  PENDING
  APPROVED
  REJECTED
}

model ScreenshotSubmission {
  id                 String            @id @default(cuid())
  url                String
  mimeType           String
  fileName           String
  fileSize           Int
  status             ScreenshotStatus  @default(PENDING)
  submittedById      String?
  submittedBy        User?             @relation("ScreenshotSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?             @relation("ScreenshotReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?           @db.Text
  developerProfileId String?
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([submittedById])
  @@index([developerProfileId])
}

enum ReportTargetType {
  PWA
  FLATPAK
  LIST
  DEVELOPER_PROFILE
}

enum ReportReason {
  MALWARE_SECURITY
  IMPERSONATION
  INAPPROPRIATE_CONTENT
  BROKEN
  OTHER
}

enum ReportStatus {
  PENDING
  DISMISSED
  ACTIONED
}

model Report {
  id            String           @id @default(cuid())
  targetType    ReportTargetType
  targetId      String
  reason        ReportReason
  details       String?          @db.Text
  reporterEmail String?
  status        ReportStatus     @default(PENDING)
  reviewedById  String?
  reviewedBy    User?            @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?          @db.Text
  createdAt     DateTime         @default(now())

  @@index([status])
  @@index([targetType, targetId])
}

model DeveloperProfileMember {
  id                 String           @id
  developerProfileId String
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String           @default("member")
  createdAt          DateTime

  @@index([developerProfileId])
  @@index([userId])
}

model DeveloperProfileInvitation {
  id                 String           @id
  developerProfileId String
  developerProfile   DeveloperProfile @relation(fields: [developerProfileId], references: [id], onDelete: Cascade)
  email              String
  role               String?
  status             String           @default("pending")
  expiresAt          DateTime
  createdAt          DateTime         @default(now())
  inviterId          String
  inviter            User             @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([developerProfileId])
  @@index([email])
}

model PwaApp {
  id                 String            @id @default(cuid())
  appid              String            @unique
  name               String
  summary            String
  description        String            @db.Text
  iconUrl            String
  screenshots        String[]
  homepageUrl        String            @default("")
  contentRating      String            @default("All ages")
  developerName      String
  url                String
  color              String            @default("#000000")
  css                String            @default("") @db.Text
  js                 String            @default("") @db.Text
  useragent          String            @default("")
  urlFilter          String            @default("")
  widevine           Boolean           @default(false)
  tray               Boolean           @default(false)
  status             PwaStatus         @default(PENDING)
  submittedById      String?
  submittedBy        User?             @relation("PwaSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?             @relation("PwaReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?           @db.Text
  developerProfileId String?
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  translations       PwaTranslation[]

  @@index([status])
  @@index([developerProfileId])
}

enum FlatpakStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  FAILED
  PULLED
}

enum FlatpakSourceType {
  BUNDLE
  GIT
}

enum FlatpakBuildResult {
  PROCESSING
  SUCCESS
  FAILED
}

enum FlatpakBuildStage {
  BUILD
  PUBLISH
}

model FlatpakApp {
  id                 String            @id @default(cuid())
  appid              String
  branch             String            @default("stable")
  name               String
  summary            String
  description        String            @db.Text
  iconUrl            String
  screenshots        String[]
  homepageUrl        String            @default("")
  contentRating      String            @default("All ages")
  developerName      String
  developerProfileId String?
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: SetNull)
  sourceType         FlatpakSourceType @default(BUNDLE)
  bundleUrl          String?
  bundleFileName     String?
  bundleSize         BigInt?
  gitUrl             String?
  gitBranch          String?
  gitManifestPath    String?
  gitLastCommit      String?
  status             FlatpakStatus     @default(PENDING)
  submittedById      String?
  submittedBy        User?             @relation("FlatpakSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedById       String?
  reviewedBy         User?             @relation("FlatpakReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  reviewNote         String?           @db.Text
  buildLog           String?           @db.Text
  buildStartedAt     DateTime?
  buildFinishedAt    DateTime?
  builds             FlatpakBuild[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([appid, branch])
  @@index([status])
  @@index([sourceType, status])
  @@index([developerProfileId])
}

model FlatpakBuild {
  id                String             @id @default(cuid())
  flatpakAppId      String
  flatpakApp        FlatpakApp         @relation(fields: [flatpakAppId], references: [id], onDelete: Cascade)
  status            FlatpakBuildResult @default(PROCESSING)
  log               String             @db.Text
  gitCommit         String?
  stage             FlatpakBuildStage  @default(PUBLISH)
  screenSessionName String
  remoteLogPath     String
  remoteExitPath    String
  triggeredById     String?
  triggeredBy       User?              @relation("FlatpakBuildTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  startedAt         DateTime           @default(now())
  finishedAt        DateTime?
  jobs              RunnerJob[]

  @@index([flatpakAppId, startedAt])
}

model InfraSettings {
  id                     String   @id @default("singleton")
  gpgPrivateKeyEncrypted String?  @db.Text
  gpgPassphraseEncrypted String?  @db.Text
  flatpakRepoTitle       String?
  flatpakRepoHomepage    String?
  flatpakRepoComment     String?
  flatpakRepoDescription String?
  flatpakRepoIconUrl     String?
  updatedAt              DateTime @updatedAt
}

model InfraAccessVerification {
  sessionId     String    @id
  codeHash      String
  codeExpiresAt DateTime
  attempts      Int       @default(0)
  verifiedAt    DateTime?
  updatedAt     DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?  @db.Text
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model WhitelistEntry {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
}

model Verification {
  id         String    @id
  identifier String
  value      String    @db.Text
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model AppInstall {
  id        String   @id @default(cuid())
  appid     String
  createdAt DateTime @default(now())

  @@index([appid])
  @@index([appid, createdAt])
}

model FlathubCache {
  appid    String   @id
  installs Int
  cachedAt DateTime @default(now())
}

model AppList {
  id                 String            @id @default(uuid())
  name               String
  slug               String?           @unique
  icon               String?
  description        String?           @db.Text
  createdById        String?
  createdBy          User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  developerProfileId String?
  developerProfile   DeveloperProfile? @relation(fields: [developerProfileId], references: [id], onDelete: SetNull)
  items              AppListItem[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([createdById])
  @@index([developerProfileId])
}

model AppListItem {
  id        String   @id @default(cuid())
  listId    String
  list      AppList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  appRef    String
  name      String
  iconUrl   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([listId, appRef])
  @@index([listId])
}

enum RunnerJobStatus {
  QUEUED
  RUNNING
  UPLOADED
  IMPORTED
  FAILED
  CANCELLED
  SKIPPED
}

model Runner {
  id          String      @id @default(cuid())
  name        String
  tokenHash   String?     @unique
  tokenHint   String?
  arch        String?
  hostname    String?
  os          String?
  version     String?
  concurrency Int?
  lastSeenAt  DateTime?
  lastIp      String?
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  jobs        RunnerJob[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model RunnerJob {
  id              String          @id @default(cuid())
  flatpakBuildId  String
  flatpakBuild    FlatpakBuild    @relation(fields: [flatpakBuildId], references: [id], onDelete: Cascade)
  arch            String
  status          RunnerJobStatus @default(QUEUED)
  runnerId        String?
  runner          Runner?         @relation(fields: [runnerId], references: [id], onDelete: SetNull)
  attempts        Int             @default(0)
  log             String          @default("") @db.Text
  logBytes        Int             @default(0)
  artifactPath    String?
  artifactSize    BigInt          @default(0)
  gitCommit       String?
  metainfoB64     String?         @db.Text
  iconB64         String?         @db.Text
  refs            String[]        @default([])
  error           String?         @db.Text
  cancelRequested Boolean         @default(false)
  claimedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime        @default(now())

  @@index([status, arch])
  @@index([runnerId])
  @@index([flatpakBuildId])
}
