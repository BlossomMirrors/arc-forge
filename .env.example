BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
DATABASE_URL=
AUTHENTIK_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# GitHub OAuth App, used for GitHub sign-in and the Flatpak Git submission repo picker
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encrypts infra secrets (SSH key, GPG passphrase) at rest. Keep distinct from BETTER_AUTH_SECRET.
FORGE_SECRETS_KEY=
# Max accepted .flatpak bundle upload size in bytes (default: 8 GiB if unset)
FLATPAK_MAX_BUNDLE_BYTES=
# Resend API key and verified sender for email notifications. From name is always
# "Arc Forge". Email notifications are ON by default; set EMAIL_NOTIFICATIONS_ENABLED=false to disable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_NOTIFICATIONS_ENABLED=
# OPSWAT MetaDefender Cloud API key, used to scan every uploaded Flatpak bundle for
# malware at submission time. Required - without it, bundle submissions are blocked.
METADEFENDER_API_KEY=
# Cloudflare Turnstile widget protecting the public abuse-report form
# (src/routes/report). Site key is embedded client-side, not sensitive.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
